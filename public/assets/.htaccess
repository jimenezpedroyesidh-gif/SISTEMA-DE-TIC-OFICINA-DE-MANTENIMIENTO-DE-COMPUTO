# Recursos estáticos (CSS/JS/imágenes). Las páginas los piden con ?v=<fecha del archivo> (asset() en
# app/Support/ui.php): esa URL cambia cuando el archivo cambia, así que el navegador puede guardarla un año sin
# volver a preguntar. Sin ?v= (p. ej. los @import de estilo.css) siempre pregunta si cambió (304 si no).
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|svg|png|jpg|webp|woff2?)$">
        Header set Cache-Control "no-cache, must-revalidate"
        Header set Cache-Control "public, max-age=31536000, immutable" "expr=%{QUERY_STRING} =~ /(^|&)v=/"
    </FilesMatch>
</IfModule>
